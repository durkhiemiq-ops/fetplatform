# Database (PostgreSQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS & CSRF (Frontend-Backend Integration)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# QR Token settings (BR-035, BR-036)
QR_TOKEN_TTL_SECONDS=10
ATTENDANCE_SESSION_TTL_SECONDS=60
REDIS_URL=redis://localhost:6379/0

# File upload limits (BR-183)
MAX_FILE_SIZE_BYTES=26214400

# Email delivery (OTP verification) — console backend for dev, SMTP for prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@fetplatform.local
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5
